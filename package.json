{
  "name": "pm-electricals-and-electronics",
  "version": "1.0.0",
  "private": true,
  "description": "Premium appliance repair booking website for PM Electricals and Electronics, Coimbatore.",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm start --prefix client",
    "dev:server": "npm run dev --prefix server",
    "build": "npm run build --prefix client",
    "start": "npm start --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "workspaces": [
    "client",
    "server"
  ]
}
